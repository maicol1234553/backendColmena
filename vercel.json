{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm install",
  "outputDirectory": "dist",

  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" }
  ]
}